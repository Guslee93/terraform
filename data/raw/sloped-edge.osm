  <tag k="description:no" v="Postveien fra Christiania til Moss (og videre sørover mot Halden mv). Gradvis ut av bruk fra ca 1860. Bare farbare deler som rimelig omtrent følger den opprinnelige traseen, er markert. For sykkelrute gjennom Akershus, se relasjon 2147926."/>
  <tag k="historic" v="highway"/>
  <tag k="name" v="Fredrikshaldske kongevei"/>
  <tag k="route" v="historic"/>
  <tag k="short_name" v="Kongeveien"/>
  <tag k="type" v="route"/>
 </relation>
