{
  "name": "terraform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Terraform — an interactive architectural site-planning portfolio prototype.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
