    "@turf/turf": "7.4.0",
    "dexie": "4.4.7",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "suncalc": "2.1.1",
    "three": "0.186.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mapbox/vector-tile": "3.0.0",
