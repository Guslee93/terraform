    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "pbf": "5.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
